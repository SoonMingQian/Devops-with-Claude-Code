# Force LF line endings in the repo for files that run inside Linux containers
*.sh            text eol=lf
Dockerfile      text eol=lf
Jenkinsfile     text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.properties    text eol=lf
*.java          text eol=lf
*.xml           text eol=lf
